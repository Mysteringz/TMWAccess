# Copy to .env (git-ignored).

# Name shown on the TMedge console. Unique per gateway.
GATEWAY_ID=site-gw-1
# Routes to TMedge, tried in order (the rest are fallbacks):
#   wss://gw.<domain>/tmgw   through Cloudflare Tunnel -- outbound HTTPS only
#   tcp://<host>:5210        e.g. the VM's Tailscale address
EDGE=wss://gw.hkumyseat.com/tmgw,tcp://100.106.57.2:5210
# Required for any non-loopback tcp route. Set only when the route is already
# encrypted/authenticated by Tailscale; TMedge also needs TMGW_ALLOW_RAW_TCP=1.
TCP_ENCRYPTED=1
# Cloudflare Access service token for the wss route (Access app gw.<domain>,
# policy action "Service Auth" including this token).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# While on a fallback, how often to try the preferred route again (seconds).
FAILBACK_S=300
# This gateway's own credential in TMedge's TMGW_KEYS_FILE (or the legacy shared TMGW_TOKEN).
TMGW_TOKEN=
# Only where the host cannot route to a tcp:// EDGE itself (e.g. a Mac whose VPN blocks
# the tailnet): a SOCKS5 proxy, such as a userspace Tailscale client's.
# SOCKS5=127.0.0.1:1055

# Where TMnodes send (their `set edges <this host's LAN IP>`).
LISTEN_HOST=0.0.0.0
LISTEN_PORT=5200
# Only nodes on these networks are relayed.
NODE_CIDRS=192.168.0.0/16
# The nodes' command port (TMnode TM_DOWNLINK_PORT).
NODE_COMMAND_PORT=5201
# Local status JSON on 127.0.0.1 (0 = off).
STATUS_PORT=5280
# Datagrams held while the edge is unreachable (10..10000; oldest dropped beyond this).
QUEUE_MAX=5000

# Firmware HTTP on the node network (0 = updates off).
IMAGE_PORT=5282
